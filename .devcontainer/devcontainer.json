
{
  "name": "Next.js + Bun",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=${localEnv:HOME}/.certs/zscaler.crt,target=/certs/zscaler.crt,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_EXTRA_CA_CERTS": "/certs/zscaler.crt",
    "SSL_CERT_FILE": "/certs/zscaler.crt",
    "NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS": "1"
  },
  "forwardPorts": [3000],
  "postCreateCommand": "bun install --frozen-lockfile"
}
