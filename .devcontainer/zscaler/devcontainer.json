{
  "name": "Next.js + Hono (Bun + Zscaler)",
  "build": {
    "dockerfile": "../../Dockerfile",
    "context": "../..",
    "target": "development"
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "mounts": [
    "source=container-bun-next-node-modules,target=/workspace/node_modules,type=volume",
    "source=container-bun-next-web-node-modules,target=/workspace/apps/web/node_modules,type=volume",
    "source=container-bun-next-api-node-modules,target=/workspace/apps/api/node_modules,type=volume",
    "source=${localEnv:HOME}/.certs/zscaler.crt,target=/certs/zscaler.crt,type=bind,readonly"
  ],
  "containerEnv": {
    "NODE_EXTRA_CA_CERTS": "/certs/zscaler.crt",
    "SSL_CERT_FILE": "/certs/zscaler.crt",
    "NEXT_TURBOPACK_EXPERIMENTAL_USE_SYSTEM_TLS_CERTS": "1"
  },
  "forwardPorts": [3000],
  "postCreateCommand": "/usr/bin/bun install --frozen-lockfile"
}
